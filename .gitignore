runtime/user_data/.testbot-ui-auth.json.bak.*
runtime/user_data/..testbot-ui-auth.json.tmp.*
runtime/user_data/..testbot-ui-auth.json.bak.*
# Equivalent patterns used by isolated auth contract tests/custom paths.
*.testbot-ui-auth.json.tmp.*
*.testbot-ui-auth.json.bak.*
# Legacy overlay may remain locally while an already running bot still holds it.
